from app.ast import (
    CompilationUnit,
    ModuleDeclaration,
    ModuleInstance,
)

from app.semantics.semantic_model import SemanticModel
from app.elaboration.instances.instance_resolver import (
    InstanceResolver,
)

child = ModuleDeclaration(
    name="child",
    ports=(),
    members=(),
)

top = ModuleDeclaration(
    name="top",
    ports=(),
    members=(
        ModuleInstance(
            module_name="child",
            parameter_overrides=(),
            instance_name="u0",
            connections=(),
        ),
    ),
)

tree = CompilationUnit(
    declarations=(
        child,
        top,
    ),
)

model = SemanticModel()

InstanceResolver().resolve(
    tree,
    model,
)

hierarchy = model.elaboration.resolved_instances

assert "top" in hierarchy.modules

assert (
    hierarchy.modules["top"]
    .instances[0]
    .instance_name
    == "u0"
)

assert (
    hierarchy.modules["top"]
    .instances[0]
    .module_name
    == "child"
)

print("Typed InstanceResolver test passed.")

